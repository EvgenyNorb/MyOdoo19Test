<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_reschedule_visit_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.reschedule.visit.wizard.form</field>
        <field name="model">hr.hospital.reschedule.visit.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Visit">
                <sheet>
                    <group string="Current Visit Information">
                        <group>
                            <field name="current_visit_id" invisible="1"/>
                            <field name="current_patient_id"/>
                            <field name="current_doctor_id"/>
                        </group>
                        <group>
                            <field name="current_date"/>
                        </group>
                    </group>

                    <separator string="New Schedule"/>

                    <group>
                        <group>
                            <field name="new_doctor_id"/>
                            <field name="new_date"/>
                        </group>
                        <group>
                            <field name="new_time" widget="float_time"/>
                        </group>
                    </group>

                    <group>
                        <field name="reason" placeholder="Вкажіть причину перенесення візиту..."/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_reschedule"
                            string="Reschedule"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_reschedule_visit_wizard" model="ir.actions.act_window">
        <field name="name">Reschedule Visit</field>
        <field name="res_model">hr.hospital.reschedule.visit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_visit"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>