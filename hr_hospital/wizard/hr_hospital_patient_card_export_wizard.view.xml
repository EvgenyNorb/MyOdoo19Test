<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_patient_card_export_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.card.export.wizard.form</field>
        <field name="model">hr.hospital.patient.card.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Patient Card">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="export_format"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>

                    <group string="Include in Export">
                        <group>
                            <field name="is_include_diagnoses"/>
                            <field name="is_include_recommendations"/>
                        </group>
                        <group>
                            <field name="language_id"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="action_export"
                            string="Export"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient_card_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Patient Card</field>
        <field name="res_model">hr.hospital.patient.card.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>