<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_mass_reassign_doctor_wizard_form" model="ir.ui.view">
        <field name="name">hr.hospital.mass.reassign.doctor.form</field>
        <field name="model">hr.hospital.mass.reassign.doctor</field>
        <field name="arch" type="xml">
            <form string="Mass Reassign Doctor">
                <sheet>
                    <group>
                        <group>
                            <field name="previous_doctor_id"/>
                            <field name="new_doctor_id"/>
                        </group>
                        <group>
                            <field name="change_date"/>
                        </group>
                    </group>

                    <group>
                        <field name="patient_ids" widget="many2many">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="doctor_id"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <field name="reason" placeholder="Вкажіть причину..."/>
                    </group>
                </sheet>

                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_mass_reassign_doctor_wizard" model="ir.actions.act_window">
        <field name="name">Mass Reassign Doctor</field>
        <field name="res_model">hr.hospital.mass.reassign.doctor</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>