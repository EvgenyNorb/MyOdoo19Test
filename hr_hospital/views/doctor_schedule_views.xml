<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_doctor_schedule_tree" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.schedule.tree ()</field>
            <field name="model">hr.hospital.doctor.schedule</field>
            <field name="arch" type="xml">
                <list string="Doctor schedule">
                    <field name="name"/>
                    <field name="date" widget="datetime"/>
                    <field name="start_time" widget="float_time"/>
                    <field name="end_time" widget="float_time"/>
                    <field name="type"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_doctor_schedule_form" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.schedule.form ()</field>
            <field name="model">hr.hospital.doctor.schedule</field>
            <field name="arch" type="xml">
                <form string="Doctor schedule">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="date" widget="datetime"/>
                                <field name="start_time" widget="float_time"/>S
                                <field name="end_time" widget="float_time"/>
                                <field name="type"/>
                                <field name="week_day"/>
                            </group>
                            <group>
                                <field name="doctor_id"/>
                                <field name="notes"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_doctor_schedule" model="ir.actions.act_window">
            <field name="name">Doctor schedule</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.doctor.schedule</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_doctor_schedule_action"
                  name="Doctor schedule"
                  action="action_hr_hospital_doctor_schedule"
                  parent="hr_hospital_menu_doctors_schedule"
                  sequence="10"/>
</odoo>