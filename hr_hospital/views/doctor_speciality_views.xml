<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_doctor_speciality_tree" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.speciality.tree ()</field>
            <field name="model">hr.hospital.doctor.speciality</field>
            <field name="arch" type="xml">
                <list string="Doctor speciality">
                    <field name="name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_doctor_speciality_form" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.speciality.form ()</field>
            <field name="model">hr.hospital.doctor.speciality</field>
            <field name="arch" type="xml">
                <form string="Doctor speciality">
                    <sheet>
                        <group>
                                <field name="name"/>
                                <field name="active"/>
                                <field name="description"/>
                                <field name="doctor_ids" widget="one2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_doctor_speciality" model="ir.actions.act_window">
            <field name="name">Doctor speciality</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.doctor.speciality</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_doctor_speciality_action"
                  name="Doctor speciality"
                  action="action_hr_hospital_doctor_speciality"
                  parent="hr_hospital_menu_doctors_speciality"
                  sequence="10"/>
</odoo>