<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_hospital_disease_tree" model="ir.ui.view">
            <field name="name">hr.hospital.disease.tree ()</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <list string="Disease">
                    <field name="name"/>
<!--                    <field name="description"/>-->
<!--                    <field name="doc_id"/>-->
<!--                    <field name="patient_ids" widget="one2many_tags" options="{'color_field': 'color'}"/>-->
                </list>
            </field>
        </record>

        <record id="hr_hospital_disease_form" model="ir.ui.view">
            <field name="name">hr.hospital.disease.form ()</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <form string="Disease">
                    <sheet>
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="patient_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                            </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_disease" model="ir.actions.act_window">
            <field name="name">Disease</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.disease</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_disease_action"
                  name="Disease"
                  action="action_hr_hospital_disease"
                  parent="hr_hospital_menu_diseases"
                  sequence="10"/>
    </data>
</odoo>