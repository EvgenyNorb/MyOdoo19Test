<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_patient_doctor_history_tree" model="ir.ui.view">
            <field name="name">hr.hospital.patient.doctor.history.tree ()</field>
            <field name="model">hr.hospital.patient.doctor.history</field>
            <field name="arch" type="xml">
                <list string="Patient doctor history">
                    <field name="name"/>
                    <field name="is_active"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_patient_doctor_history_form" model="ir.ui.view">
            <field name="name">hr.hospital.patient.doctor.history.form ()</field>
            <field name="model">hr.hospital.patient.doctor.history</field>
            <field name="arch" type="xml">
                <form string="Patient doctor history">
                    <sheet>
                        <group>
                                <field name="name"/>
                                <field name="is_active"/>
                                <field name="appointment_date" widget="datetime"/>
                                <field name="change_data" widget="datetime"/>
                                <field name="change_reason"/>
                                <field name="doctor_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                <field name="patient_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_patient_doctor_history" model="ir.actions.act_window">
            <field name="name">Patient doctor history</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.patient.doctor.history</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_patient_doctor_history_action"
                  name="Patient doctor history"
                  action="action_hr_hospital_patient_doctor_history"
                  parent="hr_hospital_menu_patient_doctor_history"
                  sequence="10"/>
</odoo>