<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_visit_tree" model="ir.ui.view">
            <field name="name">hr.hospital.visit.tree ()</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <list string="Visit">
                    <field name="name"/>
                    <field name="visit_status"/>
                    <field name="scheduled_datatime" widget="datetime"/>
                    <field name="visit_datetime" widget="datetime"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_visit_form" model="ir.ui.view">
            <field name="name">hr.hospital.visit.form ()</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <form string="Visit">
                    <sheet>
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="visit_status"/>
                                    <field name="scheduled_datatime" widget="datetime"/>
                                    <field name="visit_datetime" widget="datetime"/>
                                    <field name="type_visit"/>
                                    <field name="patient_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                    <field name="doctor_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                </group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="visit_cost"/>
                                    <field name="medical_diagnosis_ids"  widget="one2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="recommendations"/>
                                </group>
                            </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_visit" model="ir.actions.act_window">
            <field name="name">Visit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.visit</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_visit_action"
                  name="Visit"
                  action="action_hr_hospital_visit"
                  parent="hr_hospital_menu_visits"
                  sequence="10"/>
</odoo>