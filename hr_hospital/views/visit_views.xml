<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_visit_tree" model="ir.ui.view">
            <field name="name">hr.hospital.visit.tree ()</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <list string="Visit">
                    <field name="name"/>
                    <field name="visit_status"/>
                    <field name="scheduled_datatime" widget="datetime"/>
                    <field name="visit_datetime" widget="datetime"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_visit_form" model="ir.ui.view">
            <field name="name">hr.hospital.visit.form ()</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <form string="Visit">
                    <header>
                         <field name="visit_status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="visit_status"/>
                                    <field name="scheduled_datatime" widget="datetime"/>
                                    <field name="visit_datetime" widget="datetime"/>
                                    <field name="type_visit"/>
                                    <field name="patient_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                    <field name="doctor_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                </group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="visit_cost"/>
                                    <field name="medical_diagnosis_ids"  widget="one2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="recommendations"/>
                                </group>
                            </group>
                        <group>
                          <field name="specialty_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                          <field name="available_doctor_ids"  widget="one2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

     <record id="hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <calendar string="Patient visits" create="1" quick_create="1" mode="month" scales="day,month,year"
                      create_name_field="name" color="name" date_start="scheduled_datatime"
                      date_stop="visit_datetime" event_open_popup="True">
                <field name="name" filters="1" invisible="1"/>
            </calendar>
        </field>
    </record>

    <record id="hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Filters">
                <searchpanel>
                    <field name="visit_status" string="Visits status" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="hr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Example" sample="1" disable_linking="1" display_quantity="1">
                <field name="doctor_id" type="row"/>
                <field name="scheduled_datatime" interval="month" type="col"/>
                <field name="visit_status" type="col"/>
            </pivot>
        </field>
    </record>

        <record id="action_hr_hospital_visit" model="ir.actions.act_window">
            <field name="name">Visit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.visit</field>
            <field name="view_mode">list,form,calendar,pivot</field>
        </record>

        <menuitem id="menu_hr_hospital_visit_action"
                  name="Visit"
                  action="action_hr_hospital_visit"
                  parent="hr_hospital_menu_visits"
                  sequence="10"/>
</odoo>