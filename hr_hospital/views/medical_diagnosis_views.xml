<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="hr_hospital_medical_diagnosis_tree" model="ir.ui.view">
            <field name="name">hr.hospital.medical.diagnosis.tree ()</field>
            <field name="model">hr.hospital.medical.diagnosis</field>
            <field name="arch" type="xml">
                <list string="Medical_diagnosis">
                    <field name="name"/>
                    <field name="approved"/>
                    <field name="approved_datetime" widget="datetime"/>
                    <field name="severity"/>
                </list>
            </field>
        </record>

        <record id="hr_hospital_medical_diagnosis_form" model="ir.ui.view">
            <field name="name">hr.hospital.medical.diagnosis.form ()</field>
            <field name="model">hr.hospital.medical.diagnosis</field>
            <field name="arch" type="xml">
                <form string="Visit">
                    <sheet>
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="description_disease"/>
                                    <field name="prescribed_treatment"/>
                                    <field name="approved"/>
                                    <field name="doctor_approved_id"/>
                                </group>
                                <group>
                                    <field name="approved_datetime" widget="datetime"/>
                                    <field name="severity"/>
                                    <field name="visit_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                    <field name="disease_id"  widget="many2one_tags" options="{'color_field': 'color'}"/>
                                </group>
                            </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_hospital_medical_diagnosis" model="ir.actions.act_window">
            <field name="name">Medical diagnosis</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.medical.diagnosis</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_hr_hospital_medical_diagnosis_action"
                  name="Visit"
                  action="action_hr_hospital_medical_diagnosis"
                  parent="hr_hospital_menu_medical_diagnosis"
                  sequence="10"/>
</odoo>